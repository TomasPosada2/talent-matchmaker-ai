# Copia este archivo como .env y completa los valores.
# docker compose lo lee automáticamente. Nunca subas .env al repositorio.

# --- Entorno ---
APP_ENV=produccion

# --- Base de datos ---
POSTGRES_DB=talent_matchmaker
POSTGRES_USER=talent
POSTGRES_PASSWORD=cambia-esta-contrasena

# --- Autenticación (mínimo 32 caracteres) ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Claude (ranking con IA). Sin esta llave solo funciona el modo demostración ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Datos de demostración (scripts/seed_demo.py) ---
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=

# --- Privacidad y backups ---
RETENTION_DAYS=180
BACKUP_RETENTION_DAYS=14

# --- Monitoreo (opcional) ---
# Webhook entrante de Slack o Teams para alertas.
ALERT_WEBHOOK_URL=
LOG_FORMAT=json
SLOW_REQUEST_SECONDS=30
METRICS_TOKEN=

# --- Gmail (solo para el perfil "gmail") ---
POLL_INTERVAL_SECONDS=60

# --- Dominio público (solo para el perfil "proxy"; Caddy obtiene el certificado TLS) ---
DOMAIN=
